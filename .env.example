# Ключи с https://my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Чаты, в которых лайкать все новые сообщения.
# Можно id и/или @username через запятую.
# Для супергрупп и каналов id обычно выглядит как -100xxxxxxxxxx
CHAT_IDS=-1001234567890,@my_public_chat

# Реакция: heart = ❤. На Windows лучше писать слово, не эмодзи.
REACTION=heart

# Кому не ставить реакции: имя, @username или id через запятую
SKIP_USERS=Иван,@skip_user,123456789

# Кому ставить какашки вместо лайка: имя, @username или id через запятую
POOP_USERS=Пётр,@poop_user
POOP_REACTION=poop

# Ставить лайки и на свои сообщения
LIKE_OWN_MESSAGES=false

# Пауза между реакциями, чтобы не словить FloodWait
DELAY_SECONDS=0.4

# Сколько последних сообщений лайкнуть при старте. 0 — только новые
BACKFILL_LIMIT=0

# Имя файла сессии внутри папки data/
SESSION_NAME=likebot

# true — один раз вывести список чатов с id и выйти
LIST_CHATS=false

# true — вывести авторов последних сообщений и выйти
LIST_USERS=false

# Необязательно: готовая строка сессии Telethon вместо файла
# TELEGRAM_SESSION_STRING=

# Токен бота от @BotFather. В личке с ботом команда /like включает и выключает лайки
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LOG_LEVEL=INFO
